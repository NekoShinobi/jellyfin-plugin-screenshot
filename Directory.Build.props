<Project>
    <PropertyGroup>
        <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.0</JellyfinVersion>
        <Version>2.1.1.0</Version>
        <!-- Keep the Jellyfin 12 series higher so server upgrades receive its build. -->
        <Version Condition="'$(JellyfinVersion)' == '12.0.0'">3.1.1.0</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <BaseIntermediateOutputPath>obj/$(JellyfinVersion)/</BaseIntermediateOutputPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    </PropertyGroup>
</Project>
