<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(JellyfinVersion)' == '10.11.0'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinVersion)' == '12.0.0'">net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Screenshot</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Screenshot</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="js\screenshot.js" />
    <EmbeddedResource Include="js\screenshot.js" />
    <EmbeddedResource Include="js\clipping.js" />
    <EmbeddedResource Include="js\clipping.css" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Screenshot.Tests" />
  </ItemGroup>

  <!-- Plugin packaging: create {Name}_{Version}/ folder with DLL + meta.json -->
  <PropertyGroup>
    <PluginDisplayName>Screenshot Capture</PluginDisplayName>
    <PluginGuid>a3c9f1d2-4b7e-4f8a-9d0c-1e2b3a4c5d6e</PluginGuid>
    <PluginTargetAbi>$(JellyfinVersion).0</PluginTargetAbi>
    <PluginCategory>General</PluginCategory>
    <PluginOverview>Capture screenshots and create short video clips from the player.</PluginOverview>
    <PluginDescription>Provides a native screenshot capture button in the Jellyfin video player. When clicked, the server extracts the exact frame from the source file using FFmpeg and returns it as a JPEG download.</PluginDescription>
    <PluginChangelog>Render the complete clip filmstrip on the server for reliable desktop thumbnails, with authenticated loading and retry.</PluginChangelog>
    <PluginOwner>NekoShinobi</PluginOwner>
  </PropertyGroup>

  <Target Name="ValidateJellyfinVersion" BeforeTargets="Restore;PrepareForBuild">
    <Error Condition="'$(JellyfinVersion)' != '10.11.0' and '$(JellyfinVersion)' != '12.0.0'"
           Text="JellyfinVersion must be 10.11.0 or 12.0.0." />
  </Target>

  <Target Name="PackagePlugin" AfterTargets="Build">
    <PropertyGroup>
      <PluginPackageDir Condition="'$(PluginPackageDir)' == ''">$(TargetDir)$(PluginDisplayName)_$(Version)</PluginPackageDir>
      <_Timestamp>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</_Timestamp>
      <_MetaJson>{
  "category": "$(PluginCategory)",
  "changelog": "$(PluginChangelog)",
  "description": "$(PluginDescription)",
  "guid": "$(PluginGuid)",
  "imageUrl": "",
  "name": "$(PluginDisplayName)",
  "overview": "$(PluginOverview)",
  "owner": "$(PluginOwner)",
  "targetAbi": "$(PluginTargetAbi)",
  "timestamp": "$(_Timestamp)",
  "version": "$(Version)"
}</_MetaJson>
    </PropertyGroup>

    <MakeDir Directories="$(PluginPackageDir)" />

    <WriteLinesToFile
      File="$(PluginPackageDir)/meta.json"
      Lines="$(_MetaJson)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(PluginPackageDir)"
      SkipUnchangedFiles="true" />

    <Message Importance="high" Text="Plugin packaged → $(PluginPackageDir)" />
  </Target>

</Project>
